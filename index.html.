<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tiempo de asignación por caso</title>
<style>
  :root{
    --bg:#f7f8fa; --card:#ffffff; --text:#1a1d23; --muted:#6b7280;
    --border:#e5e7eb; --accent:#3b5bdb; --accent-light:#eef1fd;
    --danger:#e03131; --ok:#2f9e44; --warn:#f08c00;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#15171c; --card:#1e2128; --text:#e8eaed; --muted:#9aa0aa;
      --border:#2c3038; --accent:#6d8bff; --accent-light:#232a42;
    }
  }
  :root[data-theme="dark"]{
    --bg:#15171c; --card:#1e2128; --text:#e8eaed; --muted:#9aa0aa;
    --border:#2c3038; --accent:#6d8bff; --accent-light:#232a42;
  }
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  *{box-sizing:border-box;}
  body{margin:0; background:var(--bg); color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    font-size:15px; line-height:1.45;}
  .wrap{max-width:1150px; margin:0 auto; padding:24px 16px 60px;}
  h1{font-size:1.4rem; margin:0 0 4px;}
  .sub{color:var(--muted); margin:0 0 22px; font-size:.9rem;}
  .card{background:var(--card); border:1px solid var(--border); border-radius:12px; padding:18px; margin-bottom:18px;}
  .card h2{font-size:1rem; margin:0 0 14px;}
  .hint{font-size:.78rem; color:var(--muted); margin:2px 0 14px;}
  .map-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin-bottom:12px;}
  label{display:block; font-size:.78rem; color:var(--muted); margin-bottom:4px;}
  input,select{width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:8px;
    background:var(--bg); color:var(--text); font-size:.9rem;}
  button{cursor:pointer; border:none; border-radius:8px; padding:9px 16px; font-size:.88rem; font-weight:600;}
  .btn-primary{background:var(--accent); color:#fff;}
  .btn-primary:hover{opacity:.9;}
  .row-actions{display:flex; gap:14px; align-items:end; flex-wrap:wrap;}
  .toolbar{display:flex; flex-wrap:wrap; gap:10px; align-items:end; margin-bottom:14px;}
  .toolbar .field{min-width:170px;}
  .summary-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:10px;}
  .stat{background:var(--accent-light); border-radius:10px; padding:12px;}
  .stat .num{font-size:1.25rem; font-weight:700;}
  .stat .lbl{font-size:.75rem; color:var(--muted);}
  .table-scroll{overflow-x:auto;}
  table{width:100%; border-collapse:collapse; font-size:.83rem; min-width:760px;}
  th,td{padding:8px 10px; text-align:left; border-bottom:1px solid var(--border); white-space:nowrap;}
  th{color:var(--muted); font-weight:600; font-size:.72rem; text-transform:uppercase;}
  tr:hover td{background:var(--accent-light);}
  .pill{display:inline-block; padding:2px 9px; border-radius:999px; font-size:.72rem; font-weight:600;}
  .pill-ok{background:rgba(47,158,68,.15); color:var(--ok);}
  .pill-warn{background:rgba(240,140,0,.15); color:var(--warn);}
  .pill-danger{background:rgba(224,49,49,.15); color:var(--danger);}
  .empty{color:var(--muted); font-size:.85rem; padding:10px 0;}
</style>
</head>
<body>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<div class="wrap">
  <h1>Tiempo de asignación por caso</h1>
  <p class="sub">Sube el historial de cambios de propietario (el reporte de Salesforce). Por cada caso se calcula quién lo tiene asignado ahora mismo y desde cuándo.</p>

  <div class="card">
    <h2>1. Cargar Excel</h2>
    <p class="hint">Detectamos automáticamente la fila de encabezados aunque el archivo traiga título, filtros u otras líneas antes de la tabla, como en el reporte de Salesforce.</p>
    <input type="file" id="f-file" accept=".xlsx,.xls,.csv">
    <div id="map-area" style="display:none; margin-top:16px;">
      <div class="map-grid">
        <div><label>Número del caso</label><select id="map-numcaso"></select></div>
        <div><label>Modificado por</label><select id="map-modpor"></select></div>
        <div><label>Campo/Evento</label><select id="map-campo"></select></div>
        <div><label>Valor nuevo (a quién quedó asignado)</label><select id="map-valnuevo"></select></div>
        <div><label>Fecha de modificación (del evento)</label><select id="map-fechaevento"></select></div>
      </div>
      <div class="row-actions" style="margin-bottom:12px;">
        <div class="field" style="min-width:220px;">
          <label>Filtrar solo eventos de asignación (texto en Campo/Evento, opcional)</label>
          <input id="f-keyword" value="propietario">
        </div>
        <div class="field" style="min-width:200px;">
          <label>Hora de referencia para el cálculo</label>
          <input id="f-ahora" type="datetime-local">
        </div>
        <div class="field" style="min-width:160px;">
          <label>Marcar en rojo desde (horas)</label>
          <input id="f-horas" type="number" min="0" step="0.5" value="24">
        </div>
        <button class="btn-primary" id="btn-calc">Calcular</button>
      </div>
      <span class="hint" id="import-status"></span>
    </div>
  </div>

  <div class="card" id="results-card" style="display:none;">
    <h2>2. Resultados</h2>
    <p class="hint" id="load-time-note"></p>
    <div class="summary-grid" id="summary"></div>
  </div>

  <div class="card" id="table-card" style="display:none;">
    <div class="toolbar">
      <div class="field">
        <label>Asignado actualmente a</label>
        <select id="filter-propietario"><option value="">Todos</option></select>
      </div>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Caso</th><th>Asignado a</th><th>Desde</th><th>Tiempo asignado</th><th>Reasignaciones</th><th></th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div id="empty-msg" class="empty" style="display:none;">No hay casos que coincidan con el filtro.</div>
  </div>
</div>

<script>
(function(){
  let headers = [];
  let dataRows = []; // array of arrays, ya filtrado a filas de datos reales
  let lastEvents = [];
  let loadTimestamp = null; // hora real exacta en que se cargó el archivo

  function guessColumn(hdrs, keywords){
    const lower = hdrs.map(h => String(h||'').toLowerCase());
    for (const kw of keywords){
      const idx = lower.findIndex(h => h.includes(kw));
      if (idx !== -1) return String(idx);
    }
    return '';
  }

  function parseDate(val){
    if (val === undefined || val === null || val === '') return null;
    if (val instanceof Date && !isNaN(val)) return val;
    const s = String(val).trim();
    // dd/mm/yyyy hh:mm AM/PM
    let m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2})\s*(AM|PM)?$/i);
    if (m){
      let h = +m[4];
      if (m[6]){
        const ap = m[6].toUpperCase();
        if (ap === 'PM' && h < 12) h += 12;
        if (ap === 'AM' && h === 12) h = 0;
      }
      return new Date(+m[3], +m[2]-1, +m[1], h, +m[5]);
    }
    m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
    if (m) return new Date(+m[3], +m[2]-1, +m[1]);
    m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})[ T]?(\d{1,2})?:?(\d{2})?/);
    if (m) return new Date(+m[1], +m[2]-1, +m[3], +(m[4]||0), +(m[5]||0));
    const d = new Date(s);
    return isNaN(d) ? null : d;
  }

  function fmtDate(d){
    if (!d) return '—';
    const p = n => String(n).padStart(2,'0');
    return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  function fmtDuration(hours){
    if (hours < 1) return Math.round(hours*60) + ' min';
    if (hours < 24) return hours.toFixed(1) + ' h';
    return (hours/24).toFixed(1) + ' días';
  }

  document.getElementById('f-file').addEventListener('change', function(e){
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(evt){
      try{
        const data = new Uint8Array(evt.target.result);
        const wb = XLSX.read(data, {type:'array', cellDates:true});
        const sheet = wb.Sheets[wb.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(sheet, {header:1, defval:'', raw:false});

        // Buscar la fila de encabezados: la primera que mencione "caso" y "fecha"
        let headerIdx = -1;
        for (let i=0; i<rows.length; i++){
          const joined = rows[i].map(c=>String(c||'').toLowerCase()).join('|');
          if (joined.includes('caso') && joined.includes('fecha') && (joined.includes('propietario') || joined.includes('campo') || joined.includes('evento'))){
            headerIdx = i; break;
          }
        }
        if (headerIdx === -1){
          alert('No se pudo identificar la fila de encabezados automáticamente. Verifica el archivo.');
          return;
        }
        headers = rows[headerIdx].map(h => String(h||'').trim());

        const fill = (id) => {
          document.getElementById(id).innerHTML = headers.map((h,i)=>`<option value="${i}">${h||'(columna '+(i+1)+')'}</option>`).join('');
        };
        fill('map-numcaso'); fill('map-modpor'); fill('map-campo'); fill('map-valnuevo'); fill('map-fechaevento');

        document.getElementById('map-numcaso').value = guessColumn(headers, ['número del caso','numero del caso','n° de caso','case number']);
        document.getElementById('map-modpor').value = guessColumn(headers, ['modificado por']);
        document.getElementById('map-campo').value = guessColumn(headers, ['campo / evento','campo/evento','campo','evento']);
        document.getElementById('map-valnuevo').value = guessColumn(headers, ['valor nuevo']);
        document.getElementById('map-fechaevento').value = guessColumn(headers, ['fecha de modificaci']);

        // Filas de datos: después del encabezado, hasta que ya no tengan fecha parseable
        const fechaGuessIdx = parseInt(guessColumn(headers, ['fecha de modificaci']) || '-1', 10);
        const casoGuessIdx = parseInt(guessColumn(headers, ['número del caso','numero del caso']) || '-1', 10);
        dataRows = [];
        for (let i=headerIdx+1; i<rows.length; i++){
          const r = rows[i];
          if (!r || !r.length) continue;
          const casoVal = casoGuessIdx>=0 ? String(r[casoGuessIdx]||'').trim() : '';
          const fechaVal = fechaGuessIdx>=0 ? parseDate(r[fechaGuessIdx]) : null;
          if (casoVal && fechaVal) dataRows.push(r);
        }

        document.getElementById('map-area').style.display = 'block';
        document.getElementById('import-status').textContent = `${dataRows.length} eventos de historial detectados.`;
        loadTimestamp = new Date();

        // Intentar detectar "A partir de yyyy-mm-dd hh:mm:ss" (hora de generación del reporte de Salesforce)
        let refDate = null;
        for (let i=0; i<headerIdx; i++){
          const text = rows[i].map(c=>String(c||'')).join(' ');
          const m = text.match(/a partir de\s+(\d{4})-(\d{2})-(\d{2})[ ,]+(\d{2}):(\d{2}):(\d{2})/i);
          if (m){
            refDate = new Date(+m[1], +m[2]-1, +m[3], +m[4], +m[5], +m[6]);
            break;
          }
        }
        const ref = refDate || loadTimestamp;
        const p = n => String(n).padStart(2,'0');
        document.getElementById('f-ahora').value =
          `${ref.getFullYear()}-${p(ref.getMonth()+1)}-${p(ref.getDate())}T${p(ref.getHours())}:${p(ref.getMinutes())}`;
      }catch(err){
        alert('No se pudo leer el archivo. Verifica que sea un Excel o CSV válido.');
      }
    };
    reader.readAsArrayBuffer(file);
  });

  document.getElementById('btn-calc').addEventListener('click', function(){
    const iCaso = parseInt(document.getElementById('map-numcaso').value, 10);
    const iModPor = parseInt(document.getElementById('map-modpor').value, 10);
    const iCampo = parseInt(document.getElementById('map-campo').value, 10);
    const iValNuevo = parseInt(document.getElementById('map-valnuevo').value, 10);
    const iFecha = parseInt(document.getElementById('map-fechaevento').value, 10);
    const keyword = document.getElementById('f-keyword').value.trim().toLowerCase();
    const umbral = parseFloat(document.getElementById('f-horas').value) || 0;

    if (isNaN(iCaso) || isNaN(iFecha) || isNaN(iValNuevo)){
      alert('Selecciona al menos Número del caso, Valor nuevo y Fecha de modificación.');
      return;
    }

    const porCaso = {}; // caso -> {ultimo evento, conteo}
    dataRows.forEach(r => {
      const caso = String(r[iCaso]||'').trim();
      if (!caso) return;
      const campo = iCampo>=0 ? String(r[iCampo]||'').trim() : '';
      if (keyword && !campo.toLowerCase().includes(keyword)) return; // solo eventos de asignación
      const fecha = parseDate(r[iFecha]);
      if (!fecha) return;
      const evento = {
        caso,
        asignadoA: String(r[iValNuevo]||'').trim(),
        modificadoPor: iModPor>=0 ? String(r[iModPor]||'').trim() : '',
        campo,
        fecha
      };
      if (!porCaso[caso]) porCaso[caso] = { ultimo: evento, conteo: 0 };
      porCaso[caso].conteo++;
      if (fecha > porCaso[caso].ultimo.fecha) porCaso[caso].ultimo = evento;
    });

    const now = document.getElementById('f-ahora').value
      ? new Date(document.getElementById('f-ahora').value)
      : (loadTimestamp || new Date());
    let huboFuturas = false;
    lastEvents = Object.entries(porCaso).map(([caso, info]) => {
      let horas = (now - info.ultimo.fecha) / 3600000;
      if (horas < 0){ huboFuturas = true; horas = 0; }
      return Object.assign({}, info.ultimo, { horas, reasignaciones: info.conteo, alerta: horas >= umbral });
    });

    if (!lastEvents.length){
      alert('No se encontraron eventos de asignación con esos filtros. Revisa el texto de "Campo/Evento" o quítalo si no aplica.');
      return;
    }

    document.getElementById('results-card').style.display = 'block';
    document.getElementById('table-card').style.display = 'block';
    document.getElementById('load-time-note').textContent =
      `Calculado contra: ${fmtDate(now)}` +
      (huboFuturas ? ' — algunos eventos son posteriores a esta hora; se muestran en 0. Ajusta la hora de referencia si hace falta.' : '');
    populateOwnerFilter();
    renderAll();
  });

  function populateOwnerFilter(){
    const sel = document.getElementById('filter-propietario');
    const cur = sel.value;
    const owners = Array.from(new Set(lastEvents.map(e=>e.asignadoA).filter(Boolean))).sort((a,b)=>a.localeCompare(b));
    sel.innerHTML = '<option value="">Todos</option>' + owners.map(o=>`<option value="${o}">${o}</option>`).join('');
    if (owners.includes(cur)) sel.value = cur;
  }

  function renderSummary(){
    const avgHoras = lastEvents.length ? lastEvents.reduce((s,e)=>s+e.horas,0)/lastEvents.length : 0;
    const maxCase = [...lastEvents].sort((a,b)=>b.horas-a.horas)[0];
    const porProp = {};
    lastEvents.forEach(e=>{ porProp[e.asignadoA||'—'] = (porProp[e.asignadoA||'—']||0)+1; });
    const top = Object.entries(porProp).sort((a,b)=>b[1]-a[1])[0];
    const alertas = lastEvents.filter(e=>e.alerta).length;

    document.getElementById('summary').innerHTML = `
      <div class="stat"><div class="num">${lastEvents.length}</div><div class="lbl">Casos analizados</div></div>
      <div class="stat"><div class="num">${fmtDuration(avgHoras)}</div><div class="lbl">Tiempo promedio asignado</div></div>
      <div class="stat"><div class="num">${maxCase ? fmtDuration(maxCase.horas) : '—'}</div><div class="lbl">Caso con más tiempo (#${maxCase?maxCase.caso:'—'})</div></div>
      <div class="stat"><div class="num">${top ? top[0]+' ('+top[1]+')' : '—'}</div><div class="lbl">Quién tiene más casos asignados</div></div>
      <div class="stat"><div class="num">${alertas}</div><div class="lbl">Casos sobre el umbral de alerta</div></div>
    `;
  }

  function renderTable(){
    const owner = document.getElementById('filter-propietario').value;
    let list = lastEvents.filter(e => !owner || e.asignadoA === owner);
    list = [...list].sort((a,b)=> b.horas - a.horas);

    const tbody = document.getElementById('tbody');
    const emptyMsg = document.getElementById('empty-msg');
    if (!list.length){
      tbody.innerHTML = '';
      emptyMsg.style.display = 'block';
      return;
    }
    emptyMsg.style.display = 'none';
    tbody.innerHTML = list.map(e => {
      let pill;
      if (e.alerta) pill = '<span class="pill pill-danger">Alerta</span>';
      else if (e.horas >= 8) pill = '<span class="pill pill-warn">A tiempo</span>';
      else pill = '<span class="pill pill-ok">Reciente</span>';
      return `<tr>
        <td>${e.caso}</td>
        <td>${e.asignadoA||'—'}</td>
        <td>${fmtDate(e.fecha)}</td>
        <td>${fmtDuration(e.horas)}</td>
        <td>${e.reasignaciones}</td>
        <td>${pill}</td>
      </tr>`;
    }).join('');
  }

  function renderAll(){
    renderSummary();
    renderTable();
  }

  document.getElementById('filter-propietario').addEventListener('change', renderAll);
})();
</script>
</body>
</html>
